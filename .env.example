DEEPSEEK_API_KEY=sk-your-key-here
# Optional: Semantic Scholar API key (https://www.semanticscholar.org/product/api)
# without it the public pool is heavily rate-limited
S2_API_KEY=your-s2-key-here
# Optional: OpenAlex polite pool (raises the rate limit from 10 to 100 req/s).
# Also used as the Crossref polite-pool address when CROSSREF_MAILTO is unset.
# https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication
OPENALEX_MAILTO=you@example.com
# Optional but recommended: free OpenAlex API key. When OpenAlex sheds load it
# answers 429 "Anonymous search is temporarily rate-limited while the search
# cluster is under elevated load" -- mailto does NOT lift that one, a key does.
# Get one at https://openalex.org/ (free account -> Settings -> API key).
OPENALEX_API_KEY=your-openalex-api-key-here
# Optional: SerpAPI key (https://serpapi.com) to add Google Scholar results.
# Google has NO official Scholar API and scholar.google.com blocks direct
# scraping; SerpAPI is a paid third-party proxy that returns Scholar's organic
# results as JSON (free tier ~100 queries/month). When this is set,
# source=auto queries Semantic Scholar + OpenAlex + Google Scholar.
SERPAPI_KEY=your-serpapi-key-here
