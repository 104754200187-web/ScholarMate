# Server-side LLM defaults. The Web UI asks every browser for its own provider
# and API key, so these keys are NOT used by web runs unless the fallback below
# is explicitly enabled. They remain useful for CLI runs (agent.py, graph.py).
# Server-side CLI fallback only: deepseek (default) or openai. The Web UI has
# its own per-browser provider picker (DeepSeek, OpenAI, Anthropic, Gemini,
# Qwen, xAI, Mistral, Cohere, Groq, OpenRouter, Baidu ERNIE, Tencent Hunyuan,
# MiniMax, Kimi, Zhipu, Doubao, SiliconFlow and custom compatible services).
# Only the selected provider's key is required here.
# LLM_PROVIDER=deepseek
# DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=sk-your-key-here

# Set to 1 only for a trusted single-user deployment that wants web runs to
# spend the server keys above when a browser has not configured its own.
# LLM_ALLOW_SERVER_DEFAULT=0

# OpenAI / GPT. The default style is the Responses API; set
# OPENAI_API_STYLE=chat only for an OpenAI-compatible gateway that exposes
# /chat/completions but not /responses.
# Official model guidance recommends the Responses API:
# https://developers.openai.com/api/docs/guides/text
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-6.1-sol
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_STYLE=responses
# OPENAI_MIN_OUTPUT_TOKENS=2048
# OPENAI_REASONING_EFFORT=low

# Optional: server-owned keys for the Web UI's "免 Key 免费体验" channel.
# Only the fixed models in llm.FREE_ACCESS are served with these keys; browsers
# never receive them and cannot substitute a paid model. Leave a key unset to
# hide that provider. The free channel never falls back to the paid keys above.
# GEMINI_API_KEY=
# GROQ_API_KEY=
# ZHIPU_API_KEY=
# OPENROUTER_API_KEY=
# COHERE_API_KEY=
# BAIDU_API_KEY=
# HUNYUAN_API_KEY=
# Per-browser daily free runs. 0 disables the free channel entirely.
# FREE_LLM_DAILY_REQUESTS=5
# Process-wide daily free runs; 0 removes this extra all-site cap.
# FREE_LLM_GLOBAL_DAILY_REQUESTS=50

# Optional: Semantic Scholar API key (https://www.semanticscholar.org/product/api)
# without it the public pool is heavily rate-limited
S2_API_KEY=your-s2-key-here
# Optional: OpenAlex polite pool (raises the rate limit from 10 to 100 req/s).
# Also used as the Crossref polite-pool address when CROSSREF_MAILTO is unset.
# https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication
OPENALEX_MAILTO=you@example.com
# Optional but recommended: free OpenAlex API key. When OpenAlex sheds load it
# answers 429 "Anonymous search is temporarily rate-limited while the search
# cluster is under elevated load" -- mailto does NOT lift that one, a key does.
# Get one at https://openalex.org/ (free account -> Settings -> API key).
OPENALEX_API_KEY=your-openalex-api-key-here
# Optional: SerpAPI key (https://serpapi.com) to add Google Scholar results.
# Google has NO official Scholar API and scholar.google.com blocks direct
# scraping; SerpAPI is a paid third-party proxy that returns Scholar's organic
# results as JSON (free tier ~100 queries/month). When this is set,
# source=auto queries Semantic Scholar + OpenAlex + Google Scholar.
SERPAPI_KEY=your-serpapi-key-here

# Optional: full-text downloads for cited papers per run (one first source per
# claim when available, then upgrades). "auto" = min(24, max(8, claims + 4)); 0 disables
# full-text downloads; -1 restores the old try-every-cited-paper behaviour.
# CLAIM_FULLTEXT_BUDGET=auto

# Optional resource bounds. Defaults are shown; these are guards, not tuning
# knobs that need changing for normal use.
# FULLTEXT_MAX_INFLATE_BYTES=33554432
# FULLTEXT_MEMO_MAX_ENTRIES=128
# FULLTEXT_MEMO_MAX_CHARS=33554432
# FULLTEXT_OA_URL_MAX_ENTRIES=20000
# FULLTEXT_SKIP_MAX_ENTRIES=5000
# JOBSTORE_STALE_S=300
# WEB_GRAPH_RATE_WINDOW=60
# WEB_GRAPH_RATE_MAX=10
# WEB_GRAPH_CONCURRENCY=3

# Outbound HTTP. On a host without direct internet access, every
# source fails with "Connection refused" unless a proxy is set; put
# the real value in .env (it is gitignored), never in this file.
# HTTP_PROXY=http://user:password@proxy-host:7890
# HTTPS_PROXY=http://user:password@proxy-host:7890
# NO_PROXY=localhost,127.0.0.1,::1
